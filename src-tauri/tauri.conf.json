{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cozy Nook Widget",
  "version": "0.1.0",
  "identifier": "com.cozynook.widget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cozy Nook",
        "label": "main",
        "width": 340,
        "height": 520,
        "minWidth": 340,
        "minHeight": 520,
        "maxWidth": 340,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' https: data: blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
